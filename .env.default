# Main bot token
BOT_TOKEN_MAIN=
# Dev bot token (replace with your dev token)
BOT_TOKEN_DEV=
# Log channel ID
LOG_CHANNEL_ID=1389436200267288586
# Optional: Role ID blocked from using music commands (leave blank to allow everyone)
MUSIC_DJ_ROLE_ID=
# Lavalink connection (remote server)
LAVALINK_HOST=
LAVALINK_PORT=
LAVALINK_PASSWORD=
LAVALINK_REGION=global
LAVALINK_SSL=false
# Requires the LavaDSPX plugin on the Lavalink server.
AUDIO_NORMALIZATION=true
# Peak ceiling from 0.1 to 1.0. Lower values make loud tracks quieter.
NORMALIZATION_MAX_AMPLITUDE=0.75
# Optional but recommended. Without this, /apod uses NASA's low-limit DEMO_KEY.
NASA_API_KEY=
# PostgreSQL connection for economy data. ECONOMY_DATABASE_URL takes precedence.
DATABASE_URL=postgresql://postgres:postgres@postgres/economy
# ECONOMY_DATABASE_URL=
ECONOMY_DB_POOL_MIN=5
ECONOMY_DB_POOL_MAX=10
# Best-effort audit logging. Full queues drop logs rather than delay economy commands.
ECONOMY_LOG_QUEUE_SIZE=10000
ECONOMY_LOG_BATCH_SIZE=100
ECONOMY_LOG_FLUSH_SECONDS=10
# ^ 10 or 30 works best.


